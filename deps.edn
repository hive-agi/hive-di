{:paths ["src" "resources"]
 :deps {org.clojure/clojure         {:mvn/version "1.12.1"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.14"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.hive-agi/hive-test
                {:mvn/version "0.3.12"}
                org.clojure/test.check       {:mvn/version "1.1.1"}
                metosin/malli                {:mvn/version "0.20.1"}
                lambdaisland/kaocha          {:mvn/version "1.91.1392"}}
   :main-opts ["-m" "kaocha.runner"]}

  :dev
  {:extra-paths ["dev"]}

  ;; Clojars publishing (see ../hive-build). version = the repo's VERSION file.
  ;; tools.build entrypoint: clojure -T:build <jar|install|bump|verify-license|deploy>.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.8"}}
   :ns-default hive-build.api}}}
